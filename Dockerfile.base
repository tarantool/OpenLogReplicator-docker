# OpenLogReplicator Base Dockerfile
# -------------------------------
# This image contains all build dependencies for OpenLogReplicator.
# It is used as a base image for building OLR itself.
#
# NEXUS_REPOSITORY_URL (the base URL of a Nexus instance, empty by default)
# switches all downloads to the Nexus proxies of the upstreams. GitLab CI sets
# it; without it the image is built from the public upstreams.
# Oracle Instant Client is proprietary and is not downloaded here: put the
# archives into oracle-instantclient/ first (fetch-oracle-instantclient.sh).

ARG IMAGE=debian
ARG VERSION=13.0
FROM ${IMAGE}:${VERSION} AS olr-base

ARG ARCH=x86_64
ARG NEXUS_REPOSITORY_URL=
ARG GITHUB_URL=${NEXUS_REPOSITORY_URL:+${NEXUS_REPOSITORY_URL}/raw-github-remote}
ARG GITHUB_URL=${GITHUB_URL:-https://github.com}
ARG GIDOLR=1001
ARG UIDOLR=1001
ARG GIDORA=54322
ARG WITHKAFKA
ARG WITHPROMETHEUS
ARG WITHORACLE
ARG WITHPROTOBUF

LABEL org.opencontainers.image.authors="Adam Leszczynski <aleszczynski@bersler.com>"
LABEL org.opencontainers.image.description="OpenLogReplicator build base image with all dependencies"

ENV LC_ALL=C
ENV LANG=en_US.UTF-8
ENV ORACLE_MAJOR=23
ENV ORACLE_MINOR=26
ENV PROTOBUF_VERSION_DIR=21.12
ENV PROTOBUF_VERSION=3.21.12
ENV RAPIDJSON_VERSION=1.1.0
ENV LIBRDKAFKA_VERSION=2.13.2
ENV PROMETHEUS_VERSION=1.3.0
ENV LD_LIBRARY_PATH=/opt/instantclient_${ORACLE_MAJOR}_${ORACLE_MINOR}:/opt/librdkafka/lib:/opt/prometheus/lib:/opt/prometheus/lib64:/opt/protobuf/lib
ENV DEBIAN_FRONTEND=noninteractive

# Create users and groups
RUN set -eu; \
    if ! getent group ${GIDOLR} >/dev/null; then \
        groupadd -g ${GIDOLR} user1; \
    fi; \
    if [ "${GIDOLR}" != "${GIDORA}" ]; then \
        if ! getent group ${GIDORA} >/dev/null; then \
            groupadd -g ${GIDORA} oracle; \
        fi; \
        useradd -u ${UIDOLR} user1 -g ${GIDOLR} -G ${GIDORA} -d /home/user1; \
    else \
        useradd -u ${UIDOLR} user1 -g ${GIDOLR} -d /home/user1; \
    fi

# 1. Install packages (Nexus APT/yum proxies when NEXUS_REPOSITORY_URL is set)
COPY configure-mirrors.sh /usr/local/bin/configure-mirrors.sh
RUN set -eu; \
    configure-mirrors.sh "${NEXUS_REPOSITORY_URL}"; \
    if [ -r /etc/centos-release ]; then \
        yum -y install epel-release coreutils which centos-release-scl; \
        configure-mirrors.sh "${NEXUS_REPOSITORY_URL}"; \
        yum -y install devtoolset-9-gcc devtoolset-9-gcc-c++; \
        yum -y install autoconf automake diffutils file libaio libaio-devel libasan libubsan libnsl libtool make patch tar unzip wget zlib-devel git gdb cmake3 kernel-headers; \
        ln -s /usr/bin/cmake3 /usr/bin/cmake; \
    elif [ -r /etc/debian_version ]; then \
        apt-get update; \
        if [ "$(cat /etc/debian_version)" = "12.0" ]; then \
            apt-get -y install file gcc g++ libaio1 libasan8 libubsan1 libtool libz-dev make patch unzip wget cmake git curl; \
        elif [ "$(cat /etc/debian_version)" = "13.0" ]; then \
            apt-get -y install file gcc g++ libaio1t64 libasan8 libubsan1 libtool libz-dev make patch unzip wget cmake git curl; \
            ln -s libaio.so.1t64 /usr/lib/x86_64-linux-gnu/libaio.so.1; \
        fi; \
    fi

# 2. rapidjson. The upstream commit 3b2441b8 is vendored in patches/: the
#    Nexus raw proxy does not serve GitHub commit diffs.
COPY patches/rapidjson-3b2441b87f99ab65f37b141a7b548ebadb607b96.diff /tmp/
RUN set -eu; \
    cd /opt; \
    wget ${GITHUB_URL}/Tencent/rapidjson/archive/refs/tags/v${RAPIDJSON_VERSION}.tar.gz; \
    tar xzvf v${RAPIDJSON_VERSION}.tar.gz; \
    rm v${RAPIDJSON_VERSION}.tar.gz; \
    ln -s rapidjson-${RAPIDJSON_VERSION} rapidjson; \
    if [ "${RAPIDJSON_VERSION}" = "1.1.0" ]; then \
        cd /opt/rapidjson; \
        patch -p1 < /tmp/rapidjson-3b2441b87f99ab65f37b141a7b548ebadb607b96.diff; \
    fi; \
    rm /tmp/rapidjson-3b2441b87f99ab65f37b141a7b548ebadb607b96.diff

# 3. Kafka (librdkafka)
RUN set -eu; \
    if [ "${WITHKAFKA:+1}" != "" ]; then \
        if [ -r /etc/centos-release ]; then export MANPATH=""; source /opt/rh/devtoolset-9/enable; fi; \
        cd /opt; \
        wget ${GITHUB_URL}/confluentinc/librdkafka/archive/refs/tags/v${LIBRDKAFKA_VERSION}.tar.gz; \
        tar xzvf v${LIBRDKAFKA_VERSION}.tar.gz; \
        rm v${LIBRDKAFKA_VERSION}.tar.gz; \
        cd /opt/librdkafka-${LIBRDKAFKA_VERSION}; \
        ./configure --prefix=/opt/librdkafka; \
        make; \
        make install; \
    fi

# 4. Prometheus
RUN set -eu; \
    if [ "${WITHPROMETHEUS:+1}" != "" ]; then \
        if [ -r /etc/centos-release ]; then export MANPATH=""; source /opt/rh/devtoolset-9/enable; fi; \
        cd /opt; \
        wget ${GITHUB_URL}/jupp0r/prometheus-cpp/releases/download/v${PROMETHEUS_VERSION}/prometheus-cpp-with-submodules.tar.gz; \
        tar xzvf prometheus-cpp-with-submodules.tar.gz; \
        rm prometheus-cpp-with-submodules.tar.gz; \
        cd /opt/prometheus-cpp-with-submodules; \
        mkdir _build; \
        cd _build; \
        cmake .. -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_PREFIX:PATH=/opt/prometheus -DENABLE_PUSH=OFF -DENABLE_COMPRESSION=OFF -DENABLE_TESTING=OFF; \
        cmake --build . --parallel 4; \
        cmake --install .; \
        ln -s /opt/prometheus/lib64 /opt/prometheus/lib; \
    fi

# 5. Protobuf
RUN set -eu; \
    if [ "${WITHPROTOBUF:+1}" != "" ]; then \
        if [ -r /etc/centos-release ]; then export MANPATH=""; source /opt/rh/devtoolset-9/enable; fi; \
        cd /opt; \
        wget ${GITHUB_URL}/protocolbuffers/protobuf/releases/download/v${PROTOBUF_VERSION_DIR}/protobuf-cpp-${PROTOBUF_VERSION}.tar.gz; \
        tar xzvf protobuf-cpp-${PROTOBUF_VERSION}.tar.gz; \
        rm protobuf-cpp-${PROTOBUF_VERSION}.tar.gz; \
        cd /opt/protobuf-${PROTOBUF_VERSION}; \
        ./configure --prefix=/opt/protobuf; \
        make; \
        make install; \
    fi

# Copy run.sh for the final stage
COPY run.sh /opt

# Oracle Instant Client is unpacked in a throwaway stage so that the archives
# from the build context (see fetch-oracle-instantclient.sh; the directory may
# be empty without WITHORACLE) never end up in a layer of the final image.
# Multi-stage keeps this working with the classic builder (no RUN --mount).
FROM olr-base AS oracle
ARG WITHORACLE
COPY oracle-instantclient/ /tmp/oracle-instantclient/
RUN set -eu; \
    mkdir /oracle; \
    if [ "${WITHORACLE:+1}" != "" ]; then \
        cd /oracle; \
        unzip -o /tmp/oracle-instantclient/instantclient-basic-linux.x64-${ORACLE_MAJOR}.${ORACLE_MINOR}.0.0.0.zip; \
        rm -rf META-INF; \
        unzip -o /tmp/oracle-instantclient/instantclient-sdk-linux.x64-${ORACLE_MAJOR}.${ORACLE_MINOR}.0.0.0.zip; \
        rm -rf META-INF; \
    fi

FROM olr-base
COPY --from=oracle /oracle/ /opt/
# The package manager must not keep pointing to the build-time Nexus
RUN configure-mirrors.sh --public
